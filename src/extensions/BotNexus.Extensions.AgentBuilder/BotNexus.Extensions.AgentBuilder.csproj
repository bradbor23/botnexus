<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BotNexus.Extensions.AgentBuilder</RootNamespace>
    <Description>Serves the BotNexus Agent Builder web app (static SPA) at /agent-builder via an endpoint contributor.</Description>
  </PropertyGroup>

  <!-- WebApplication, PhysicalFileProvider, and the Http/SendFile extensions. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- IEndpointContributor lives in Gateway.Abstractions. Path is relative to the
       extension's home in the gateway repo: src/extensions/BotNexus.Extensions.AgentBuilder/. -->
  <ItemGroup>
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
  </ItemGroup>

  <!-- The manifest and the prebuilt SPA travel into the build output, which the CLI's
       `serve gateway` deploy step copies recursively to ~/.botnexus/extensions/<id>/. -->
  <ItemGroup>
    <Content Include="botnexus-extension.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
